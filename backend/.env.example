# Copy this file to .env and fill in values to enable model-backed AI analysis.
# ClankerShield works fully without any of these set - it falls back to
# deterministic local analysis grounded in the scan evidence.

# Any OpenAI-compatible chat completions endpoint.
CLANKER_AI_API_KEY=
CLANKER_AI_BASE_URL=https://api.openai.com/v1
CLANKER_AI_MODEL=gpt-4o-mini

# Comma-separated list of origins allowed to call this API (defaults to the
# Vite dev server if unset).
CLANKER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional JSON path for persistent repository-scoped copilot conversations.
# Defaults to backend/.clankershield-data/conversations.json.
CLANKER_CONVERSATIONS_PATH=

# Optional exact-version Open Source Vulnerabilities (OSV) advisory lookup.
# Disabled by default so offline scans never pretend an advisory lookup ran.
CLANKER_OSV_ENABLED=false
CLANKER_MAX_UPLOAD_BYTES=26214400
CLANKER_MAX_EXTRACTED_BYTES=104857600
CLANKER_MAX_MEMBERS=5000
CLANKER_AUTH_REQUIRED=false
CLANKER_AUTH_SECRET=replace-with-a-long-random-secret
CLANKER_AUTH_DATA_PATH=backend/.clankershield-data/auth_users.json
# Local development only; set false when a real email transport is configured.
CLANKER_DEV_AUTH_TOKENS=true
CLANKER_SECURE_COOKIES=false

# Placeholder only - runtime execution of scanned repository code is not
# implemented. Do not enable this without a hardened, network-isolated
# sandbox (see README "Production security work").
CLANKER_ENABLE_TEST_EXECUTION=false
